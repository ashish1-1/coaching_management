<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- SUBJECT TREE -->
    <record id="view_coaching_subject_tree" model="ir.ui.view">
        <field name="name">coaching.subject.list</field>
        <field name="model">coaching.subject</field>
        <field name="arch" type="xml">
            <list>
                <field name="class_id"/>
                <field name="name"/>
                <field name="teacher_id"/>
            </list>
        </field>
    </record>

    <!-- SUBJECT FORM -->
    <record id="view_coaching_subject_form" model="ir.ui.view">
        <field name="name">coaching.subject.form</field>
        <field name="model">coaching.subject</field>
        <field name="arch" type="xml">
            <form string="Subject">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="class_id"/>
                        <field name="teacher_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- SUBJECT ACTION -->
    <record id="action_coaching_subjects" model="ir.actions.act_window">
        <field name="name">Subjects</field>
        <field name="res_model">coaching.subject</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>