<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_student_fee_list" model="ir.ui.view">
        <field name="name">coaching.student.fee.list</field>
        <field name="model">coaching.student.fee</field>
        <field name="arch" type="xml">
            <list>
                <field name="student_id"/>
                <field name="fee_structure_id"/>
                <field name="amount"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_student_fee_form" model="ir.ui.view">
        <field name="name">coaching.student.fee.form</field>
        <field name="model">coaching.student.fee</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_create_invoice"
                            type="object"
                            string="Create Invoice"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,invoiced,paid"/>
                </header>
                <sheet>
                    <group>
                        <field name="student_id"/>
                        <field name="fee_structure_id"/>
                        <field name="amount" readonly="1"/>
                        <field name="invoice_id" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_student_fee" model="ir.actions.act_window">
        <field name="name">Student Fee</field>
        <field name="res_model">coaching.student.fee</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>