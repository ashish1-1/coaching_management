<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- STUDENT TREE -->
    <record id="view_coaching_student_list" model="ir.ui.view">
        <field name="name">coaching.student.list</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="coaching_class_id"/>
            </list>
        </field>
    </record>

    <!-- STUDENT FORM -->
    <record id="view_coaching_student_form" model="ir.ui.view">
        <field name="name">coaching.student.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='function']" position="before">
                <field name="coaching_class_id" invisible="is_coaching_student != True" options="{'no_create': True}"/>
            </xpath>

            <xpath expr="//page[@name='contact_addresses']" position="before">
                <page string="Guardians" invisible="is_coaching_student != True" autofocus="autofocus">
                    <field name="guardian_ids" context="{'default_is_coaching_guardian': True}">
                        <list>
                            <field name="name"/>
                            <field name="phone"/>
                            <field name="email"/>
                        </list>
                    </field>
                </page>
                <page string="Exams" invisible="is_coaching_student != True">
                    <field name="exam_ids" readonly="1"/>
                </page>

                <page string="Fees" invisible="is_coaching_student != True">
                    <!-- <field name="invoice_ids" readonly="1"/> -->
                </page>
            </xpath>
        </field>
    </record>

    <!-- STUDENT ACTION -->
    <record id="action_coaching_students" model="ir.actions.act_window">
        <field name="name">Students</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_coaching_student_list"/>
        <field name="domain">[('is_coaching_student','=',True)]</field>
        <field name="context">{'default_is_coaching_student': True}</field>
    </record>

</odoo>