<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- TEACHER TREE -->
    <record id="view_coaching_teacher_list" model="ir.ui.view">
        <field name="name">coaching.teacher.list</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="phone"/>
                <field name="email"/>
            </list>
        </field>
    </record>

    <!-- TEACHER FORM -->
    <record id="view_coaching_teacher_form" model="ir.ui.view">
        <field name="name">coaching.teacher.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='contact_addresses']" position="before">
                <page string="Subjects" invisible="is_coaching_teacher != True" autofocus="autofocus">
                    <field name="subject_ids">
                        <list>
                            <field name="class_id" />
                            <field name="name" />
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- TEACHER ACTION -->
    <record id="action_coaching_teachers" model="ir.actions.act_window">
        <field name="name">Teachers</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_coaching_teacher_list"/>
        <field name="domain">[('is_coaching_teacher','=',True)]</field>
        <field name="context">{'default_is_coaching_teacher': True}</field>
    </record>

</odoo>