<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- GUARDIAN TREE -->
    <record id="view_coaching_guardian_list" model="ir.ui.view">
        <field name="name">coaching.guardian.list</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="student_ids" widget="many2many_tags" string="Son/Daughter"/>
                <field name="phone"/>
                <field name="email"/>
            </list>
        </field>
    </record>

    <!-- GUARDIAN FORM -->
    <record id="view_coaching_guardian_form" model="ir.ui.view">
        <field name="name">coaching.guardian.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='function']" position="before">
                <field name="student_ids" invisible="is_coaching_guardian != True" widget="many2many_tags" string="Son/Daughter"/>
            </xpath>
        </field>
    </record>

    <!-- GUARDIAN ACTION -->
    <record id="action_coaching_guardians" model="ir.actions.act_window">
        <field name="name">Guardians</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_coaching_guardian_list"/>
        <field name="domain">[('is_coaching_guardian','=',True)]</field>
        <field name="context">{'default_is_coaching_guardian': True}</field>
    </record>

</odoo>