<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fee_structure_list" model="ir.ui.view">
        <field name="name">coaching.fee.structure.list</field>
        <field name="model">coaching.fee.structure</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="class_id"/>
                <field name="amount"/>
            </list>
        </field>
    </record>

    <record id="view_fee_structure_form" model="ir.ui.view">
        <field name="name">coaching.fee.structure.form</field>
        <field name="model">coaching.fee.structure</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="class_id"/>
                        <field name="product_id"/>
                        <field name="amount"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fee_structure" model="ir.actions.act_window">
        <field name="name">Fee Structure</field>
        <field name="res_model">coaching.fee.structure</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_fee_structure_list"/>
    </record>
</odoo>